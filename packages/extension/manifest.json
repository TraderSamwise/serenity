{
  "manifest_version": 3,
  "name": "Serenity",
  "version": "0.1.0",
  "description": "Suppress abusive inbound creator messages before they are read.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://www.youtube.com/*",
    "https://www.instagram.com/*",
    "https://www.twitch.tv/*",
    "https://onlyfans.com/*",
    "https://fansly.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://www.youtube.com/watch*", "https://www.twitch.tv/*"],
      "js": ["dist/content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
