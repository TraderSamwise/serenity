{
  "name": "@serenity/classifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "fixtures:write": "tsx src/write-corpus.ts",
    "classify": "node --env-file-if-exists=.env.local --import tsx src/run.ts",
    "price:probe": "node --env-file-if-exists=.env.local --import tsx src/price-probe.ts",
    "golden:gate": "node --import tsx src/golden-gate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@serenity/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
